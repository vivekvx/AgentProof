# Local development fixtures only. Do not use production credentials.
DATABASE_URL=postgresql://agentproof:agentproof@127.0.0.1:55432/agentproof
TEST_DATABASE_URL=postgresql://agentproof:agentproof@127.0.0.1:55432/agentproof_test
TEMPORAL_ADDRESS=127.0.0.1:7233
TEST_TEMPORAL_ADDRESS=127.0.0.1:7233
API_ADDRESS=127.0.0.1:8080
# A host directory mounted read-only into the API and worker. Put developer-owned
# external HTTP/JSON agent configurations here; do not put credentials in them.
AGENTPROOF_AGENT_CONFIG_DIR=./.local/agents
# The API requires a local-only bearer token for both native and Compose startup.
# Generate one before `make api` or `make dev-docker`:
# export AGENTPROOF_API_TOKEN="$(openssl rand -hex 32)"
# Optional. Docker Compose starts Jaeger with an OTLP HTTP receiver.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

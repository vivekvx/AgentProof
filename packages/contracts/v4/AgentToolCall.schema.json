{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentproof.agent-tool-call.v1",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "trial_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
    "operation_id": {"type": "string", "format": "uuid"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "arguments": {"type": "object", "maxProperties": 32}
  },
  "required": ["schema_version", "run_id", "trial_id", "sequence", "operation_id", "tool", "arguments"]
}

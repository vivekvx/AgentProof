{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentproof.agent-task-envelope.v1",
  "title": "Agent Task Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "trial_id": {"type": "string", "format": "uuid"},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "request": {"type": "string", "minLength": 1, "maxLength": 2000},
    "tools": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/tool"}},
    "limits": {"$ref": "#/$defs/limits"},
    "deadline_unix_ms": {"type": "integer", "minimum": 1},
    "resume_token": {"type": ["string", "null"], "maxLength": 256}
  },
  "required": ["schema_version", "run_id", "trial_id", "scenario_id", "request", "tools", "limits", "deadline_unix_ms", "resume_token"],
  "$defs": {
    "tool": {
      "type": "object", "additionalProperties": false,
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "description": {"type": "string", "maxLength": 300}, "input_schema": {"type": "object", "maxProperties": 32}},
      "required": ["name", "description", "input_schema"]
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {"max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 32}, "max_message_bytes": {"type": "integer", "minimum": 256, "maximum": 65536}},
      "required": ["max_tool_calls", "max_message_bytes"]
    }
  }
}

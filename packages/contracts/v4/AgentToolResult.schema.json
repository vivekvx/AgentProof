{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentproof.agent-tool-result.v1",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "trial_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
    "operation_id": {"type": "string", "format": "uuid"},
    "ok": {"type": "boolean"},
    "result": {"type": "object", "maxProperties": 64},
    "error_code": {"enum": ["unknown_tool", "invalid_arguments", "unauthorized", "budget_exhausted", "deadline_exceeded", "unavailable", "replay_mismatch"]}
  },
  "required": ["schema_version", "run_id", "trial_id", "sequence", "operation_id", "ok"],
  "oneOf": [
    {"properties": {"ok": {"const": true}, "result": {"type": "object"}}, "required": ["result"], "not": {"required": ["error_code"]}},
    {"properties": {"ok": {"const": false}, "error_code": {"enum": ["unknown_tool", "invalid_arguments", "unauthorized", "budget_exhausted", "deadline_exceeded", "unavailable", "replay_mismatch"]}}, "required": ["error_code"], "not": {"required": ["result"]}}
  ]
}

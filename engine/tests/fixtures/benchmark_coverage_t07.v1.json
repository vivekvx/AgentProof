            {
              "kind": "tool",
              "tool": "get_order",
              "operation_key": "read-1",
              "arguments": {
                "order_id": "T07-O-1"
              }
            },
            {
              "kind": "tool",
              "tool": "refund_order",
              "operation_key": "refund-1",
              "arguments": {
                "order_id": "T07-O-1",
                "amount_cents": 1200
              },
              "obligation_id": "requested-refund"
            },
            {
              "kind": "final",
              "resolution": "completed"
            }
          ],
          "expected_effect_counts": {

FROM golang:1.26.5-bookworm AS go
FROM ghcr.io/astral-sh/uv:0.11.14 AS uv
FROM node:22-bookworm-slim AS node

FROM go AS api
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY apps/api ./apps/api
COPY packages/contracts ./packages/contracts
COPY db ./db
RUN go version > /go.version && go build -o /api ./apps/api/cmd/server
ENV API_ADDRESS=0.0.0.0:8080
CMD ["/api"]

FROM python:3.13-slim-bookworm AS worker
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY engine/pyproject.toml engine/uv.lock ./engine/
COPY engine/agentproof ./engine/agentproof
COPY go.mod go.sum package.json package-lock.json Dockerfile.dev .dockerignore Makefile ./
COPY apps/api ./apps/api
COPY apps/web/src ./apps/web/src
COPY --from=api /go.version ./go.version
COPY packages/contracts ./packages/contracts
COPY db ./db
RUN --mount=type=cache,target=/root/.cache/uv uv sync --project engine --frozen --no-dev
CMD ["uv", "run", "--project", "engine", "--frozen", "--no-dev", "python", "-m", "agentproof.worker"]

FROM node AS web
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/web ./apps/web
ENV API_PROXY_TARGET=http://api:8080
CMD ["npm", "run", "dev", "--workspace", "apps/web", "--", "--host", "0.0.0.0"]

FROM mcr.microsoft.com/playwright:v1.64.1-noble AS verify
RUN apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /usr/local/bin/uv
ENV PATH=/usr/local/go/bin:$PATH
ENV UV_PYTHON=3.13 CI=true CGO_ENABLED=0
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.npm npm ci && uv sync --project engine --frozen
CMD ["make", "verify"]
